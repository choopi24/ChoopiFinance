# Choopi Finance — server environment
# Copy to .env and adjust. Values below are examples, not real secrets.

# Port the API/server listens on (default: 3001)
PORT=3001

# Secret used to sign JWT auth tokens.
# REQUIRED in production: the server refuses to start if this is unset or left
# at the development default. Use a long, random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret

# JWT lifetime. Accepts a zeit/ms string (e.g. "30d", "12h", "90d").
# Note: the app currently issues 30d tokens (90d when "stay signed in").
JWT_EXPIRES_IN=30d

# Set to "true" to mark the auth cookie as Secure (HTTPS-only).
# Leave false for plain-HTTP LAN usage; set true when serving over HTTPS.
COOKIE_SECURE=false
