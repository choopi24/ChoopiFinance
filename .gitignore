node_modules/
dist/
.env
.env.local

# SQLite database
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

# Build outputs
client/dist/
server/dist/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Automated DB backups
server/data/backups/

# Vendored at install time by scripts/sync-assets.mjs — copies of files that
# already live in node_modules, so they are generated, not source.
web/vendor/
web/fonts/

# Local TLS material generated by `npm run setup:https`.
# The private key must never be committed; the CA copy is regenerable.
server/certs/

# The passcode hash. Not a secret you'd want in history even as a hash.
server/config/

# Generated PWA icons — rebuilt by `npm run icons` on install.
web/icons/
